{
  "name": "orgchartr",
  "private": true,
  "version": "0.10.1",
  "workspaces": [
    "shared",
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "npm run build -w shared && concurrently -k -n SERVER,FRONTEND -c blue,green \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "npm run dev -w server",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w shared && npm run build -w frontend && npm run build -w server",
    "build:shared": "npm run build -w shared",
    "version:check": "node scripts/check-version.cjs",
    "verify:local-bundle": "node scripts/assert-local-bundle.cjs",
    "start": "npm run start -w server"
  },
  "overrides": {
    "nanoid": "6.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
